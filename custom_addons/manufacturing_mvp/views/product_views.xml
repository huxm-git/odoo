<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 产品模板表单视图扩展 -->
    <record id="view_product_template_form_mvp" model="ir.ui.view">
        <field name="name">product.template.form.mvp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="生产信息" name="production_info">
                    <group>
                        <group string="生产参数">
                            <field name="production_time"/>
                            <field name="min_stock_level"/>
                            <field name="supplier_lead_time"/>
                        </group>
                        <group string="状态信息">
                            <field name="stock_status" readonly="1"/>
                            <field name="production_status"/>
                        </group>
                    </group>
                    <group string="快速操作">
                        <button name="action_check_stock_level" 
                                string="检查库存水平" 
                                type="object" 
                                class="btn-primary"/>
                        <button name="action_create_production_order"
                                string="创建生产订单"
                                type="object"
                                class="btn-secondary"
                                invisible="not bom_ids"/>
                        <button name="setup_manufacturing_routes"
                                string="⚙️ 配置制造路由"
                                type="object"
                                class="btn-info"
                                invisible="not sale_ok or purchase_ok"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- 产品模板列表视图扩展 -->
    <record id="view_product_template_tree_mvp" model="ir.ui.view">
        <field name="name">product.template.tree.mvp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="stock_status" widget="badge"
                       decoration-success="stock_status == 'in_stock'"
                       decoration-warning="stock_status == 'low_stock'"
                       decoration-danger="stock_status == 'out_of_stock'"/>
                <field name="min_stock_level"/>
                <field name="production_time"/>
            </xpath>
        </field>
    </record>

    <!-- 产品看板视图 -->
    <record id="view_product_template_kanban_mvp" model="ir.ui.view">
        <field name="name">product.template.kanban.mvp</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="list_price"/>
                <field name="qty_available"/>
                <field name="stock_status"/>
                <field name="min_stock_level"/>
                <field name="production_time"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('product.template', 'image_128', record.id.raw_value)" 
                                     alt="Product" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="badge" 
                                          t-attf-class="badge-#{record.stock_status.raw_value == 'in_stock' ? 'success' : record.stock_status.raw_value == 'low_stock' ? 'warning' : 'danger'}">
                                        <t t-if="record.stock_status.raw_value == 'in_stock'">有库存</t>
                                        <t t-if="record.stock_status.raw_value == 'low_stock'">库存不足</t>
                                        <t t-if="record.stock_status.raw_value == 'out_of_stock'">缺货</t>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>库存: <field name="qty_available"/> / 最低: <field name="min_stock_level"/></div>
                                    <div>生产时间: <field name="production_time"/> 小时</div>
                                    <div>价格: <field name="list_price" widget="monetary"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 扫码产品搜索视图 -->
    <record id="view_product_scan_search" model="ir.ui.view">
        <field name="name">product.template.search.scan</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="产品扫码搜索">
                <field name="name" string="产品名称/条码" 
                       filter_domain="['|', ('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                <field name="barcode"/>
                <field name="categ_id"/>
                <separator/>
                <filter string="有库存" name="in_stock" 
                        domain="[('stock_status', '=', 'in_stock')]"/>
                <filter string="库存不足" name="low_stock" 
                        domain="[('stock_status', '=', 'low_stock')]"/>
                <filter string="缺货" name="out_of_stock" 
                        domain="[('stock_status', '=', 'out_of_stock')]"/>
                <separator/>
                <filter string="可生产" name="can_produce" 
                        domain="[('bom_ids', '!=', False)]"/>
                <group expand="0" string="分组">
                    <filter string="库存状态" name="group_stock_status" 
                            context="{'group_by': 'stock_status'}"/>
                    <filter string="产品类别" name="group_category" 
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 产品库存管理动作 -->
    <record id="action_product_stock_management" model="ir.actions.act_window">
        <field name="name">智能库存管理</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('type', '=', 'product')]</field>
        <field name="context">{
            'search_default_group_stock_status': 1,
        }</field>
        <field name="search_view_id" ref="view_product_scan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建您的第一个产品！
            </p>
            <p>
                在这里您可以管理所有产品的库存信息，包括：
                <ul>
                    <li>实时库存查询</li>
                    <li>库存预警设置</li>
                    <li>快速扫码操作</li>
                    <li>生产计划创建</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- 批量配置制造路由动作 -->
    <record id="action_setup_all_manufacturing_routes" model="ir.actions.server">
        <field name="name">⚙️ 批量配置制造路由</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = model.setup_all_manufacturing_routes()
        </field>
    </record>
</odoo>
