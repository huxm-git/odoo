<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 生产订单表单视图扩展 -->
    <record id="view_mrp_production_form_mvp" model="ir.ui.view">
        <field name="name">mrp.production.form.mvp</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_assign_workers"
                        string="👥 分配工人"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('confirmed',)"/>
                <button name="action_start_production"
                        string="▶️ 开始生产"
                        type="object"
                        class="btn-success"
                        invisible="state not in ('confirmed',)"/>
                <button name="action_quality_check"
                        string="🔍 质量检查"
                        type="object"
                        class="btn-info"
                        invisible="production_stage not in ('in_production',)"/>
                <button name="action_pause_production"
                        string="⏸️ 暂停生产"
                        type="object"
                        class="btn-warning"
                        invisible="production_stage not in ('in_production',)"/>
                <button name="action_resume_production"
                        string="▶️ 恢复生产"
                        type="object"
                        class="btn-success"
                        invisible="production_stage != 'on_hold'"/>
            </xpath>
            
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="production_line"/>
                <field name="priority_level"/>
                <field name="production_stage"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="生产排班" name="production_schedule">
                    <group>
                        <group string="人员安排">
                            <field name="scheduled_workers"/>
                            <field name="actual_workers"/>
                        </group>
                        <group string="工时统计">
                            <field name="estimated_hours"/>
                            <field name="actual_hours"/>
                            <field name="production_efficiency" widget="percentage"/>
                        </group>
                    </group>
                    <group string="质量控制">
                        <field name="quality_check_required"/>
                        <field name="quality_check_passed"
                               readonly="not quality_check_required"/>
                        <field name="quality_notes"
                               invisible="not quality_check_required"/>
                    </group>
                    <group string="生产备注">
                        <field name="production_notes" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- 生产排班看板视图 -->
    <record id="view_mrp_production_kanban_schedule" model="ir.ui.view">
        <field name="name">mrp.production.kanban.schedule</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban default_group_by="production_line" class="o_kanban_small_column">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="scheduled_workers"/>
                <field name="actual_workers"/>
                <field name="estimated_hours"/>
                <field name="production_stage"/>
                <field name="priority_level"/>
                <field name="state"/>
                <field name="production_line"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="product_id"/>
                                        </div>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button">
                                            <span class="fa fa-ellipsis-v" title="更多操作"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="record.state.raw_value == 'confirmed'" 
                                               name="action_assign_workers" type="object" class="dropdown-item">👥 分配工人</a>
                                            <a t-if="record.state.raw_value == 'confirmed'" 
                                               name="action_start_production" type="object" class="dropdown-item">▶️ 开始生产</a>
                                            <a t-if="record.production_stage.raw_value == 'in_production'" 
                                               name="action_quality_check" type="object" class="dropdown-item">🔍 质量检查</a>
                                            <a t-if="record.production_stage.raw_value == 'in_production'" 
                                               name="action_pause_production" type="object" class="dropdown-item">⏸️ 暂停生产</a>
                                            <a t-if="record.production_stage.raw_value == 'on_hold'" 
                                               name="action_resume_production" type="object" class="dropdown-item">▶️ 恢复生产</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_tags_section">
                                        <span t-attf-class="badge badge-#{record.priority_level.raw_value == '2' ? 'danger' : record.priority_level.raw_value == '1' ? 'warning' : 'secondary'}">
                                            <t t-if="record.priority_level.raw_value == '2'">🔴 非常紧急</t>
                                            <t t-if="record.priority_level.raw_value == '1'">🟡 紧急</t>
                                            <t t-if="record.priority_level.raw_value == '0'">⚪ 正常</t>
                                        </span>
                                        <span t-attf-class="badge badge-#{record.production_stage.raw_value == 'completed' ? 'success' : record.production_stage.raw_value == 'in_production' ? 'info' : record.production_stage.raw_value == 'on_hold' ? 'warning' : 'secondary'}">
                                            <t t-if="record.production_stage.raw_value == 'planning'">📋 计划中</t>
                                            <t t-if="record.production_stage.raw_value == 'material_ready'">📦 物料就绪</t>
                                            <t t-if="record.production_stage.raw_value == 'in_production'">🏭 生产中</t>
                                            <t t-if="record.production_stage.raw_value == 'quality_check'">🔍 质检中</t>
                                            <t t-if="record.production_stage.raw_value == 'completed'">✅ 已完成</t>
                                            <t t-if="record.production_stage.raw_value == 'on_hold'">⏸️ 暂停</t>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>数量:</strong> <field name="product_qty"/>
                                    </div>
                                    <div>
                                        <strong>工人:</strong> 
                                        <field name="actual_workers"/>/<field name="scheduled_workers"/>
                                    </div>
                                    <div>
                                        <strong>预计工时:</strong> <field name="estimated_hours"/> 小时
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" 
                                               options="{'classes': {'draft': 'default', 'confirmed': 'info', 'progress': 'warning', 'to_close': 'success', 'done': 'success', 'cancel': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 生产排班搜索视图 -->
    <record id="view_mrp_production_search_schedule" model="ir.ui.view">
        <field name="name">mrp.production.search.schedule</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='todo']" position="after">
                <separator/>
                <filter string="生产中" name="in_production"
                        domain="[('production_stage', '=', 'in_production')]"/>
                <filter string="质检中" name="quality_check"
                        domain="[('production_stage', '=', 'quality_check')]"/>
                <filter string="暂停中" name="on_hold"
                        domain="[('production_stage', '=', 'on_hold')]"/>
                <separator/>
                <filter string="紧急订单" name="urgent"
                        domain="[('priority_level', 'in', ['1', '2'])]"/>
            </xpath>
            <xpath expr="//group[last()]" position="inside">
                <filter string="生产线" name="group_production_line"
                        context="{'group_by': 'production_line'}"/>
                <filter string="生产阶段" name="group_production_stage"
                        context="{'group_by': 'production_stage'}"/>
                <filter string="优先级" name="group_priority"
                        context="{'group_by': 'priority_level'}"/>
            </xpath>
        </field>
    </record>

    <!-- 生产排班看板动作 -->
    <record id="action_mrp_production_schedule_board" model="ir.actions.act_window">
        <field name="name">生产排班看板</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'in', ['confirmed', 'progress', 'to_close'])]</field>
        <field name="context">{
            'search_default_group_production_line': 1,
            'search_default_in_production': 1,
        }</field>
        <field name="view_id" ref="view_mrp_production_kanban_schedule"/>
        <field name="search_view_id" ref="view_mrp_production_search_schedule"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建您的第一个生产订单！
            </p>
            <p>
                生产排班看板帮助您：
                <ul>
                    <li>🏭 可视化生产线状态</li>
                    <li>👥 管理工人分配</li>
                    <li>⏱️ 跟踪生产进度</li>
                    <li>🔍 质量控制管理</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- 生产订单管理动作 -->
    <record id="action_mrp_production_mvp" model="ir.actions.act_window">
        <field name="name">生产订单</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建您的第一个生产订单！
            </p>
            <p>
                在这里您可以：
                <ul>
                    <li>📋 创建新的生产订单</li>
                    <li>🏭 管理生产流程</li>
                    <li>👥 分配生产工人</li>
                    <li>📊 跟踪生产进度</li>
                    <li>🔍 质量控制管理</li>
                </ul>
            </p>
        </field>
    </record>
</odoo>
