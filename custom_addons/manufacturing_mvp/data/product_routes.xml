<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- 激活MTO路由 -->
        <function model="stock.route" name="write">
            <value model="stock.route" search="[('id', '=', ref('stock.route_warehouse0_mto'))]"/>
            <value eval="{'active': True}"/>
        </function>
        
        <!-- 为Strict®系列产品配置制造和MTO路由 -->

        <!-- 使用function标签来更新现有产品的路由 -->
        <function model="product.template" name="write">
            <value model="product.template" search="[('name', 'like', 'Strict®'), ('sale_ok', '=', True), ('purchase_ok', '=', False)]"/>
            <value eval="{'route_ids': [(6, 0, [ref('mrp.route_warehouse0_manufacture'), ref('stock.route_warehouse0_mto')])]}"/>
        </function>
        
    </data>
</odoo>
